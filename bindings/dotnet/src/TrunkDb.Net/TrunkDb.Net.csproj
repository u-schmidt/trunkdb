<Project Sdk="Microsoft.NET.Sdk">
  <!-- trunkdb from C#, over its C ABI (SPEC §177.9, §180). The library,
       trunkdb.dll, libtrunkdb.dylib or libtrunkdb.so, is not in here:
       a program puts it beside its executable. -->
  <PropertyGroup>
    <!-- Not TrunkDb.dll: Windows doesn't tell it from the C library,
         trunkdb.dll, and .NET would load the one for the other. -->
    <AssemblyName>TrunkDb.Net</AssemblyName>
    <RootNamespace>TrunkDb</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
